# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.
#
# Every variable below is optional UNLESS marked REQUIRED: config.py falls back
# to the same default it always used when a variable is unset, so an empty
# .env (or no .env at all) behaves exactly like the pre-refactor hardcoded
# config, except for the Oracle credentials (see "Database" below).

# ── Database (Oracle) ────────────────────────────────────────────────────────
# REQUIRED — src/config.py has no fallback for these; the app previously
# committed a live password and bank-identifying username directly in source.
DB_HOST=your-oracle-host
DB_PORT=1521
DB_SERVICE=XE
DB_USER=your-oracle-user
DB_PASSWORD=your-oracle-password

# Max rows fetched per query (default: 100)
DB_MAX_ROWS=100

# ── Ollama (LLM serving) ─────────────────────────────────────────────────────
# Local daemon vs. remote proxy — pick one. Current effective default (if this
# is left unset) is the remote proxy shown here:
OLLAMA_URL=http://3.109.51.228/OllamaProxy/api/generate
# OLLAMA_URL=http://localhost:11434/api/generate

# Exact Ollama model tag SQLCoder-style SQL generation runs on (must exist in
# `ollama list` and, ideally, in MODEL_PROFILES in src/config.py)
OLLAMA_MODEL=hf.co/defog/sqlcoder-7b-2:Q5_K_M

# Context window sent to Ollama (default: 8192)
OLLAMA_NUM_CTX=8192

# How long Ollama keeps a model resident after a request — avoids reloading
# the model on every idle-then-request cycle (default: 30m)
OLLAMA_KEEP_ALIVE=30m

# Optional overrides for the ACTIVE model's generation knobs only (the ones
# baked into MODEL_PROFILES[OLLAMA_MODEL] in src/config.py). Leave unset to
# use the profile's built-in values.
# OLLAMA_NUM_PREDICT=512
# OLLAMA_TEMPERATURE=0.0

# Table/column selection (src/selector.py) is deterministic and makes no LLM
# call — SELECTOR_MODEL / SELECTOR_OUTPUT_FORMAT no longer exist.

# ── Embedding / retrieval ─────────────────────────────────────────────────────
# Sentence-transformers model for schema/table/column embeddings (default: BAAI/bge-large-en)
EMBED_MODEL=BAAI/bge-large-en

# BGE's required query-side instruction prefix — only change this if you also
# change EMBED_MODEL to a non-BGE model; otherwise retrieval quality silently
# degrades. Leave unset unless you know you need to change it.
# MUST stay double-quoted if set: the trailing space before the closing quote
# is part of the required value, and dotenv strips trailing whitespace from
# unquoted values.
# QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# Which folder retrieval reads its FAISS indexes / schema.json from
# (default: embedding_building/cims_raq_quarterly)
EMBEDDING_DIR=embedding_building/cims_raq_quarterly

# Retrieval breadth/precision knobs (defaults: 3, 5, 8)
TOP_K_TABLES=3
TOP_K_COLUMNS=5
SHORTLIST_K=8

# Token budget for the multi-part UNION ALL SQL generation case (default: 1024)
MINIMAL_MULTIPART_NUM_PREDICT=1024

# ── XBRL business-semantics layer (src/business_semantics.py) ───────────────
# How much business context to inject into the SQL-generation prompt.
# Cumulative levels (default: off):
#   off         nothing rendered
#   units       reporting-unit line only (fixes a silent 100000x error)
#   metrics     + business label -> column cards
#   aggregation + stock/flow SUM guidance
#   dimensions  + usable dimension axes with their live literals
#   derivation  + a rollup formula expressed in physical columns
# Roll out ONE level at a time with an eval run between each — see
# src/business_semantics.py's module docstring. Requires concept_map.json in
# EMBEDDING_DIR; without it every level silently degrades to "off".
# BUSINESS_SEMANTICS_LEVEL=aggregation
